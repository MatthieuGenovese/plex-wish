# Copier ce fichier en .env (jamais versionné) puis adapter les valeurs.
# Générer un secret : openssl rand -base64 48
#                ou (PowerShell) : [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))

# --- Médias ---------------------------------------------------------------------------
# Dossier de vidéos sur l'hôte, monté en LECTURE SEULE dans le backend (/media).
# Sur le NAS, par exemple : /volume1/animes. En local : ./dev-media
MEDIA_PATH=./dev-media
# Utilisateur/groupe (numériques) qui ont le droit de LIRE MEDIA_PATH.
# Sur Synology : se connecter en SSH et taper `id <utilisateur>`.
PUID=1000
PGID=1000

# --- Réseau -----------------------------------------------------------------------------
# Port publié sur l'hôte (le reverse proxy DSM pointe dessus).
WEB_PORT=8080
# Adresse publique (utilisée à partir de la phase 2, vérification de l'Origin).
PUBLIC_URL=https://anime.example.com
# IP ou plage CIDR du reverse proxy autorisée à fournir X-Forwarded-For.
# Par défaut : réseaux Docker privés. À restreindre une fois l'IP vue par nginx connue (ARCHITECTURE §5.4.1).
TRUSTED_PROXY_IPS=172.16.0.0/12

# --- Base de données ----------------------------------------------------------------
POSTGRES_DB=anime
POSTGRES_USER=anime
POSTGRES_PASSWORD=change-me

# --- Sécurité (utilisé à partir de la phase 2) -----------------------------------
# Deux secrets DIFFÉRENTS, au moins 32 caractères chacun.
JWT_SECRET=
STREAM_SIGNING_SECRET=
# Admin créé au premier démarrage s'il n'en existe aucun. Peut être retiré ensuite.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
# false uniquement pour tester en HTTP sans reverse proxy.
COOKIE_SECURE=true
# Délai de tolérance (secondes) pour un refresh token tout juste remplacé.
REFRESH_REUSE_GRACE_SECONDS=20

# --- Outils -------------------------------------------------------------------------------
# Swagger UI sur /q/swagger-ui (true pour tester l'API, false en usage normal).
SWAGGER_ENABLED=false
# Origines autorisées en CORS, séparées par des virgules. Vide = aucune (normal en prod).
CORS_ORIGINS=
# Mémoire max de la JVM du backend.
JAVA_OPTS=-Xmx512m
