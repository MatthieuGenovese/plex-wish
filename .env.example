# PILE DE DÉVELOPPEMENT ET D'ESSAI (docker-compose.yml). Sur le NAS, aucun .env : voir docs/DEPLOIEMENT.md.
# Copier ce fichier en .env (jamais versionné) puis adapter les valeurs.
# Générer un secret : openssl rand -base64 48
#                ou (PowerShell) : [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))

# --- Médias ---------------------------------------------------------------------------
# Dossier de vidéos sur l'hôte, monté en LECTURE SEULE dans le backend (/media).
# Sur le NAS, par exemple : /volume1/animes. En local : ./dev-media
MEDIA_PATH=./dev-media
# Utilisateur/groupe (numériques) qui ont le droit de LIRE MEDIA_PATH (et d'écrire dans POSTERS_HOST_PATH et REMUX_CACHE_PATH).
# Sur Synology : se connecter en SSH et taper `id <utilisateur>`.
PUID=1000
PGID=1000

# --- Réseau -----------------------------------------------------------------------------
# Port publié sur l'hôte (le reverse proxy DSM pointe dessus : http://127.0.0.1:8080).
WEB_PORT=8080
# Interface d'écoute de ce port. 127.0.0.1 (défaut) : seul le NAS lui-même (reverse proxy DSM) y accède.
# 0.0.0.0 : tout le réseau local aussi (essai sans reverse proxy ; HTTP en clair, session perdue au F5).
WEB_BIND=127.0.0.1
# OBLIGATOIRE. Adresse exacte que tapent les utilisateurs dans le navigateur (schéma + domaine
# [+ port]), sans chemin. Le backend refuse de démarrer sans elle, et une valeur fausse bloque
# la connexion depuis le navigateur (voir README, « PUBLIC_URL »).
PUBLIC_URL=https://anime.example.com
# Sous-réseau du réseau Docker interne (fixe, pour connaître sa passerelle).
# À changer seulement s'il est déjà utilisé sur la machine (message "Pool overlaps").
DOCKER_SUBNET=172.30.64.0/24
# Adresses autorisées à fournir X-Forwarded-For à nginx (séparées par des virgules) : le reverse
# proxy DSM, qui arrive par la passerelle du réseau Docker = DOCKER_SUBNET avec .1 à la fin.
# Vérifier avec scripts/check-client-ip.sh (ARCHITECTURE §5.4.1). Ne jamais mettre 0.0.0.0/0.
TRUSTED_PROXY_IPS=172.30.64.1

# --- Base de données ----------------------------------------------------------------
POSTGRES_DB=anime
POSTGRES_USER=anime
POSTGRES_PASSWORD=change-me

# --- Sécurité ------------------------------------------------------------------------------
# OBLIGATOIRES : deux secrets DIFFÉRENTS, au moins 32 caractères chacun. Le backend refuse de
# démarrer sinon. Changer JWT_SECRET invalide les access tokens en cours (renouvelés automatiquement).
# Générer chacun avec `openssl rand -hex 32` (ou la commande PowerShell du README, « Générer les secrets »).
JWT_SECRET=
STREAM_SIGNING_SECRET=
# Admin créé au premier démarrage s'il n'en existe aucun. Peut être retiré ensuite.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
# Durée de validité d'une URL de lecture (le lecteur en redemande une après une longue pause).
STREAM_URL_LIFETIME=6h
# Délai de tolérance (secondes, entre 10 et 30) pour un refresh token tout juste remplacé
# (deux onglets qui rafraîchissent en même temps).
REFRESH_REUSE_GRACE_SECONDS=20

# --- Métadonnées -------------------------------------------------------------------------
# Affiches, synopsis (en anglais) et année récupérés sur AniList en tâche de fond (accès Internet
# sortant vers graphql.anilist.co). false = pas de métadonnées, la bibliothèque fonctionne pareil.
METADATA_ENABLED=true

# Synopsis en français depuis TMDB (facultatif ; sans clé : synopsis anglais d'AniList).
# Clé gratuite, usage non commercial : https://www.themoviedb.org/settings/api
# Préférer le « jeton d'accès en lecture » (API Read Access Token). Lu par le backend seulement, jamais logué.
TMDB_READ_TOKEN=
TMDB_API_KEY=

# Affiches téléchargées sur le NAS (au lieu d'être chargées par chaque navigateur depuis TMDB / AniList).
# Dossier HÔTE, distinct de MEDIA_PATH, en ÉCRITURE pour PUID:PGID (voir README, « Affiches sur le NAS »).
# Environ 100 Ko par animé (≈ 150 Mo pour 1 300 animés). Sur Synology, par exemple :
# POSTERS_HOST_PATH=/volume1/docker/anime-server/posters
POSTERS_HOST_PATH=./posters
# false = pas de téléchargement : affiches chargées depuis leur source.
POSTERS_ENABLED=true

# Distribution (personnages et doubleurs japonais, depuis AniList), en tâche de fond après les métadonnées.
# Photos des comédiens dans POSTERS_HOST_PATH/cast (≈ 0,35 à 0,6 Go pour ~1 300 animés). false = arrêt de la récupération.
CAST_ENABLED=true
# Rôles gardés par animé (principaux d'abord, puis secondaires), toutes saisons confondues.
CAST_MAX_ROLES=20

# Analyse des fichiers avec ffprobe (durée, codecs, pistes ; onglet admin « Médias »), en tâche de fond,
# priorité basse, en pause pendant un scan. false : arrêtée (l'analyse déjà faite reste).
MEDIA_PROBE_ENABLED=true

# Remux à la demande : AVI et OGM copiés en MKV sans ré-encodage au premier lancement sur Android.
# Dossier HÔTE du cache, distinct de MEDIA_PATH, en ÉCRITURE pour PUID:PGID (comme les affiches). Sur Synology :
# REMUX_CACHE_PATH=/volume1/docker/anime-server/remux-cache
REMUX_CACHE_PATH=./remux-cache
# Taille maximale du cache (Go). Une copie ≈ la taille de l'original (~200 Mo par épisode de 24 min) :
# 50 Go ≈ 250 épisodes. Au-delà, les copies les moins récemment lues sont effacées (refaites à la demande).
REMUX_CACHE_MAX_GB=50

# --- Outils -------------------------------------------------------------------------------
# Swagger UI sur /q/swagger-ui (true pour tester l'API, false en usage normal).
SWAGGER_ENABLED=false
# Origines autorisées en CORS, séparées par des virgules. Vide = aucune (normal en prod).
CORS_ORIGINS=
# Mémoire max de la JVM du backend.
JAVA_OPTS=-Xmx512m

# --- Test du scan sur la bibliothèque factice (README, « Tester le scan complet ») -----
# Décommenter pour que toutes les commandes docker compose utilisent le volume factice
# (séparateur ";" sous Windows, ":" sous Linux).
#COMPOSE_FILE=docker-compose.yml;docker-compose.fake-media.yml
