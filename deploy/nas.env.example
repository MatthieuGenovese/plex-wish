# Réglages d'Anime Server sur le NAS. Écrit par l'installateur (install.sh) : en principe rien à modifier.
# AUCUN secret ici (ils sont créés au premier démarrage, dans des volumes Docker).
# Après une modification : docker compose --env-file nas.env up -d

# --- Version installée (changée par update.sh) ---------------------------------------------------------
ANIME_VERSION=1.0.0
# Registre des images (compte ou organisation GitHub dédié aux images).
IMAGE_PREFIX=ghcr.io/mon-compte-images

# --- Dossiers du NAS -------------------------------------------------------------------------------------
# Dossier des vidéos, monté en LECTURE SEULE (jamais modifié). Exemple : /volume1/animes
MEDIA_PATH=/volume1/animes
# Utilisateur qui lit ce dossier : trouvé tout seul au démarrage. À imposer seulement si l'assistant le demande
# (nombres affichés par la commande « id <utilisateur> »).
#MEDIA_UID=1026
#MEDIA_GID=100

# --- Adresse publique ---------------------------------------------------------------------------------------
# Adresse exacte que les utilisateurs tapent (https://, sans chemin ni / final).
PUBLIC_URL=https://mon-anime.duckdns.org
# Port de l'assistant de premier lancement, sur le réseau local uniquement.
LAN_PORT=8080

# --- Divers -------------------------------------------------------------------------------------------------
TZ=Europe/Paris
# Sous-réseau Docker interne (à changer seulement s'il est déjà utilisé : message « Pool overlaps »).
DOCKER_SUBNET=172.30.64.0/24
