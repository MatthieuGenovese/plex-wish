# Modèle traité au démarrage par l'image nginx officielle (envsubst).

# Journal sans query string ($uri au lieu de $request) : les futures URL de
# streaming signées (?sig=...) ne doivent jamais apparaître dans les logs.
log_format anime '$remote_addr - [$time_local] "$request_method $uri $server_protocol" '
                 '$status $body_bytes_sent "$http_user_agent" $request_time';

# Porte du RÉSEAU LOCAL (port publié sur le NAS, jamais redirigé par la box) : sur le NAS, l'assistant de premier
# lancement seulement (LAN_ENTRY=lan) ; dans la pile de développement, tout le site (LAN_ENTRY=local).
server {
    listen 80;
    set $anime_entry ${LAN_ENTRY};
    server_name _;
    server_tokens off;
    access_log /var/log/nginx/access.log anime;

    # --- Vraie IP du client (ARCHITECTURE §5.4.1) ---------------------------------
    # On ne croit X-Forwarded-For que s'il vient d'un proxy de confiance (Caddy, Funnel ou le reverse proxy du DSM) :
    # liste générée au démarrage depuis TRUSTED_PROXY_IPS par /docker-entrypoint.d/15-real-ip.sh.
    # real_ip_recursive : on garde l'adresse la plus à droite qui n'est pas un proxy de confiance.
    include /etc/nginx/real-ip.conf;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # --- En-têtes de sécurité (aussi sur les erreurs) --------------------------------
    include /etc/nginx/snippets/security-headers.conf;

    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/snippets/app-locations.conf;
}

# Porte PUBLIQUE (D1.3) : seulement Caddy (HTTPS, Internet) ou Funnel, depuis le réseau Docker interne ; ce port
# n'est jamais publié sur le NAS. Pendant l'installation, le serveur y répond « installation en cours ».
server {
    listen 8081;
    set $anime_entry public;
    server_name _;
    server_tokens off;
    access_log /var/log/nginx/access.log anime;

    # --- Vraie IP du client (ARCHITECTURE §5.4.1) ---------------------------------
    # On ne croit X-Forwarded-For que s'il vient d'un proxy de confiance (Caddy, Funnel ou le reverse proxy du DSM) :
    # liste générée au démarrage depuis TRUSTED_PROXY_IPS par /docker-entrypoint.d/15-real-ip.sh.
    # real_ip_recursive : on garde l'adresse la plus à droite qui n'est pas un proxy de confiance.
    include /etc/nginx/real-ip.conf;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # --- En-têtes de sécurité (aussi sur les erreurs) --------------------------------
    include /etc/nginx/snippets/security-headers.conf;

    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/snippets/app-locations.conf;
}
